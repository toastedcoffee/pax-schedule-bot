# Copy to .env and fill in. .env is gitignored and must never be committed.

# Required. Discord Developer Portal -> your application -> Bot -> Reset Token.
DISCORD_TOKEN=

# Optional. Your server's ID (enable Developer Mode, right-click the server,
# Copy Server ID). When set, slash commands register to that server instantly.
# When unset, they register globally and can take up to an hour to appear.
PAXBOT_GUILD_ID=

# Optional. Which show in shows.toml to serve. Defaults to west.
PAXBOT_SHOW=west

# Optional. Defaults suit the Docker image; override for a standalone run.
# PAXBOT_DB=/data/paxbot.db
# PAXBOT_CONFIG=/app/shows.toml
# PAXBOT_LOG_LEVEL=INFO

# Optional, Docker only. The uid/gid the container runs as. Defaults to 568,
# TrueNAS SCALE's built-in `apps` user. Must own the host data directory.
# PAXBOT_UID=568
# PAXBOT_GID=568
