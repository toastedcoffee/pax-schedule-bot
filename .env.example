# Settings for compose.yml. For a checkout, copy to .env next to compose.yml
# and fill in; .env is gitignored and must never be committed. In Dockge, paste
# these into the stack's .env editor. In Portainer, add them as the stack's
# environment variables.

# Required. Discord Developer Portal -> your application -> Bot -> Reset Token.
DISCORD_TOKEN=

# Optional. Your server's ID (enable Developer Mode, right-click the server,
# Copy Server ID). When set, slash commands register to that server instantly.
# When unset, they register globally and can take up to an hour to appear.
PAXBOT_GUILD_ID=

# Optional. Which show in shows.toml to serve. Defaults to west.
PAXBOT_SHOW=west

# Optional, Docker only. Where the database lives on the host. Defaults to
# ./data next to compose.yml. On TrueNAS use a dataset with the "Apps"
# permission preset.
# PAXBOT_DATA_DIR=/mnt/tank/apps/paxbot/data

# Optional, Docker only. The uid/gid the container runs as. Defaults to 568,
# TrueNAS SCALE's built-in `apps` user. Must own the data directory.
# PAXBOT_UID=568
# PAXBOT_GID=568

# Optional, Docker only. Which published image tag to run. Defaults to latest;
# pin a sha-xxxxxxx tag to hold a version.
# PAXBOT_TAG=latest

# Optional. Defaults to INFO.
# PAXBOT_LOG_LEVEL=INFO

# Standalone (no Docker) only; compose.yml sets these itself.
# PAXBOT_DB=paxbot.db
# PAXBOT_CONFIG=shows.toml
