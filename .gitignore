# --- Secrets -----------------------------------------------------------------
.env
.env.*
!.env.example

# --- Local data --------------------------------------------------------------
# The bot's SQLite store and anything it syncs. Never committed: schedule data
# is PAX's, and saved schedules are users'.
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
data/
var/

# --- Working files -----------------------------------------------------------
# Plans, specs, reports, design docs and scratch notes stay local. They are for
# building the project, not for people using it.
docs/superpowers/
.superpowers/
plans/
specs/
reports/
notes/
scratch/
*.local.md
*.draft.md

# --- Tooling -----------------------------------------------------------------
.claude/
.vscode/
.idea/

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# --- OS ----------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
